<Window x:Class="Wc3ModelViewer.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Model" Height="880" Width="560"
        WindowStartupLocation="CenterOwner" Background="#1E2024"
        ResizeMode="CanResize" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Export" Width="90" Padding="4" IsDefault="True" Click="OnExportClick"/>
            <Button Content="Cancel" Width="70" Padding="4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <!-- Batch: the models being exported, in place of the one model's sequence list -->
        <DockPanel x:Name="BatchPanel" DockPanel.Dock="Bottom" Height="250" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="BatchTitle" DockPanel.Dock="Top" Foreground="#DDD" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Animations:" Foreground="#DDD" VerticalAlignment="Center"/>
                <ComboBox x:Name="BatchSeqCombo" Width="200" Margin="8,0,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="All sequences"/>
                    <ComboBoxItem Content="None (static rest pose)"/>
                </ComboBox>
                <TextBlock Text="names map to SC2's automatically" Foreground="#889" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <ListBox x:Name="BatchList" Background="#14161A" Foreground="#CCC" BorderBrush="#333"
                     VirtualizingStackPanel.IsVirtualizing="True"/>
        </DockPanel>

        <!-- Sequences (exported into the .m3) -->
        <DockPanel x:Name="SequencePanel" DockPanel.Dock="Bottom" Height="250" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Sequences to export (.m3 sequences)" Foreground="#DDD"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="All" Width="42" Padding="2" Click="OnAllSeqClick"/>
                <Button Content="None" Width="46" Padding="2" Margin="4,0,0,0" Click="OnNoneSeqClick"/>
                <TextBlock x:Name="SeqHint" Foreground="#889" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="With no sequence selected the model exports static: one empty Stand, drawn in its rest pose."/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,2">
                <TextBlock DockPanel.Dock="Right" Text="exports as (editable)" Foreground="#889" Width="146" TextAlignment="Left"/>
                <TextBlock Text="original name" Foreground="#889"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#14161A" BorderBrush="#333" BorderThickness="1">
                <ItemsControl x:Name="SequenceChecks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,1">
                                <TextBox DockPanel.Dock="Right" Width="140" Padding="2,1" MaxLength="60"
                                         Text="{Binding ExportName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Sequence name written into the .m3 (SC2 standard names: Stand, Walk, Attack, Death, Spell…)"/>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,1" Foreground="#CCC"
                                          VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" Foreground="#CCC" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Label}"/>
                                </CheckBox>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Formats" Foreground="#DDD" FontWeight="Bold" Margin="0,0,0,4"/>
            <WrapPanel>
                <CheckBox x:Name="M3Check" Content=".m3 (StarCraft II)" IsChecked="True" Foreground="#CCC" Margin="0,2,14,2"
                          ToolTip="Direct .m3 with textures under Assets\Textures\ — no external tools needed. Drop the exported folder into an SC2 map or preview the .m3 in the cutscene editor."/>
                <CheckBox x:Name="GltfCheck" Content=".gltf (Blender)" IsChecked="False" Foreground="#CCC" Margin="0,2,0,2"
                          ToolTip="Skeleton, skinning, textures and baked animations; for editing in Blender (re-export .m3 there with m3studio)"/>
            </WrapPanel>

            <TextBlock Text="Textures" Foreground="#DDD" FontWeight="Bold" Margin="0,10,0,4"/>
            <CheckBox x:Name="ConvertPbrCheck" Content="Convert Reforged PBR → SC2 specular (_diff / _norm / _spec)"
                      IsChecked="True" Foreground="#CCC" Margin="0,2,0,2"
                      ToolTip="Affects the .m3 only — it replaces the Photoshop reforged.jsx step. glTF is metallic-roughness itself and always carries the full PBR set. SD models always export their composited diffuse"/>
            <CheckBox x:Name="GeosetVisCheck" Content="Geoset visibility animation (GEOA)" IsChecked="True"
                      Foreground="#CCC" Margin="0,2,0,2"
                      ToolTip="Hides weapons/corpse parts per sequence, like in game"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Team colour:" Foreground="#DDD" VerticalAlignment="Center"/>
                <ComboBox x:Name="TeamColorCombo" Width="130" Margin="8,0,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="Red (player 1)"/>
                    <ComboBoxItem Content="Blue (player 2)"/>
                    <ComboBoxItem Content="Teal (player 3)"/>
                    <ComboBoxItem Content="Purple (player 4)"/>
                    <ComboBoxItem Content="Yellow (player 5)"/>
                    <ComboBoxItem Content="Orange (player 6)"/>
                    <ComboBoxItem Content="Green (player 7)"/>
                    <ComboBoxItem Content="Pink (player 8)"/>
                </ComboBox>
                <TextBlock Text="glTF only — an .m3 takes it live from StarCraft II"
                           Foreground="#889" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Geometry" Foreground="#DDD" FontWeight="Bold" Margin="0,10,0,4"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LOD:" Foreground="#DDD" VerticalAlignment="Center"/>
                <ComboBox x:Name="LodCombo" Width="130" Margin="8,0,0,0"/>
                <CheckBox x:Name="VisibleOnlyCheck" Content="visible geosets only" Foreground="#CCC"
                          VerticalAlignment="Center" Margin="14,0,0,0"
                          ToolTip="Export only the geosets currently checked in the viewer"/>
            </StackPanel>

            <TextBlock Text="Effects" Foreground="#DDD" FontWeight="Bold" Margin="0,10,0,4"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="BakeFxCheck" Content="Bake PopcornFX effects into sprite sheets" IsChecked="True" Foreground="#CCC"
                          VerticalAlignment="Center"
                          ToolTip="Renders each Reforged spell effect, as its scripts play it, into an 8x8 sprite sheet at the Warcraft III camera angle and plays it on one StarCraft II particle — the picture Warcraft III shows. Off: one particle system per effect layer. Ribbons, trails and player-coloured layers stay particle systems either way."/>
                <TextBlock Text="Sheet size:" Foreground="#DDD" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <ComboBox x:Name="FxAtlasCombo" Width="90" Margin="8,0,0,0" SelectedIndex="0"
                          ToolTip="1024 is what Blizzard's own effects use (128-pixel frames, ~1.4 MB per effect); 2048 is four times the size. Auto takes 1024, or 2048 for an effect wider than about 320 units so a pixel never covers more than 2.5 units.">
                    <ComboBoxItem Content="auto"/>
                    <ComboBoxItem Content="1024"/>
                    <ComboBoxItem Content="2048"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Export scale" Foreground="#DDD" FontWeight="Bold" Margin="0,10,0,4"
                       ToolTip="Multiplies all geometry, bone and animation positions"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ScaleBox" Width="70" Padding="4" Text="1.0"/>
                <TextBlock Text="1.0 = StarCraft II scale · 40 = native WC3 units (war3mod maps)"
                           Foreground="#889" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Text="File size" Foreground="#DDD" FontWeight="Bold" Margin="0,10,0,4"/>
            <CheckBox x:Name="ReduceKeysCheck" Content="Reduce animation keys" IsChecked="True" Foreground="#CCC" Margin="0,2,0,2"
                      ToolTip="Drops the baked 30 fps keys the game would interpolate to anyway. Every kept curve stays within 0.25° and 0.05 units of the full bake — the export reports the exact figures. Usually ~90% off the .m3."/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Max texture size:" Foreground="#DDD" VerticalAlignment="Center"/>
                <ComboBox x:Name="TexSizeCombo" Width="130" Margin="8,0,0,0" SelectedIndex="2"
                          ToolTip="Larger textures are filtered down before compression. Blizzard's own SC2 unit textures are 1024 or smaller; Reforged sets are 2048 (5.6 MB each). Opaque maps also go DXT1, half the size of DXT5.">
                    <ComboBoxItem Content="Original"/>
                    <ComboBoxItem Content="2048"/>
                    <ComboBoxItem Content="1024"/>
                    <ComboBoxItem Content="512"/>
                </ComboBox>
                <TextBlock Text="1024 matches Blizzard's SC2 units · Original keeps Reforged's 2048"
                           Foreground="#889" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Output" Foreground="#DDD" FontWeight="Bold" Margin="0,10,0,4"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Width="80" Padding="4" Margin="6,0,0,0" Click="OnBrowseClick"/>
                <TextBox x:Name="OutDirBox" Padding="4" TextChanged="OnOutputChanged"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Layout:" Foreground="#DDD" VerticalAlignment="Center" Width="80"/>
                <ComboBox x:Name="LayoutCombo" Width="220" SelectedIndex="0" SelectionChanged="OnOutputChanged">
                    <ComboBoxItem Content="One folder per model"
                                  ToolTip="Each model gets its own &lt;Name&gt;\Assets\ folder with its textures — one package per model to hand around."/>
                    <ComboBoxItem Content="Shared Assets folder"
                                  ToolTip="Every model goes straight into one Assets\ folder and every texture into one Assets\Textures\ — the whole collection is a single folder to merge into your map or mod. Texture names carry a content hash, so identical textures are written once and different ones never overwrite each other."/>
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="ModelNameRow" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Model name:" Foreground="#DDD" VerticalAlignment="Center" Width="80"/>
                <TextBox x:Name="ModelNameBox" Width="220" Padding="3" MaxLength="80" TextChanged="OnOutputChanged"
                         ToolTip="File name of the exported .m3 (and its folder in the per-model layout)"/>
            </StackPanel>
            <TextBlock x:Name="LayoutHint" Foreground="#889" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- filler so the sequence panel keeps its docked height -->
        <Border Background="Transparent"/>
    </DockPanel>
</Window>
