<Window x:Class="Wc3ModelViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="Warcraft III Model Viewer" Height="760" Width="1200"
        Background="#1E2024">
    <DockPanel>
        <!-- Install path bar -->
        <Grid DockPanel.Dock="Top" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Warcraft III install:" Foreground="#DDD"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="InstallPath" Text="C:\games\Warcraft III"
                     VerticalContentAlignment="Center" Padding="4"/>
            <Button Grid.Column="2" x:Name="OpenButton" Content="Open" Width="90" Margin="8,0,0,0"
                    Padding="4" Click="OnOpenClick"/>
            <Button Grid.Column="3" x:Name="OpenFileButton" Content="Open file…" Width="90" Margin="8,0,0,0"
                    Padding="4" Click="OnOpenFileClick"
                    ToolTip="Open a loose .mdx model from disk (custom models); its textures are found next to the file, stock references from the CASC"/>
            <Button Grid.Column="4" x:Name="ExportButton" Content="Export…" Width="90" Margin="8,0,0,0"
                    Padding="4" Click="OnExportClick" IsEnabled="False"
                    ToolTip="Export the loaded model to .m3 for StarCraft II (and optionally .gltf for Blender)"/>
        </Grid>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#14161A" Padding="8,4">
            <TextBlock x:Name="Status" Foreground="#9AA" Text="Enter your install path and click Open."/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="240" MinWidth="160"/>
            </Grid.ColumnDefinitions>

            <!-- Asset browser -->
            <DockPanel Grid.Column="0" Margin="8,0,0,8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <ComboBox DockPanel.Dock="Right" x:Name="ArtSetCombo" Width="76" Margin="4,0,0,0"
                              SelectionChanged="OnFilterChanged" ToolTip="Which art set to browse">
                        <ComboBoxItem Content="HD+SD" IsSelected="True"/>
                        <ComboBoxItem Content="HD"/>
                        <ComboBoxItem Content="SD"/>
                    </ComboBox>
                    <TextBox x:Name="Filter" Padding="4" TextChanged="OnFilterChanged"
                             ToolTip="Filter models by name or folder"/>
                </DockPanel>
                <ListBox x:Name="AssetList" SelectionChanged="OnAssetSelected"
                         Background="#14161A" Foreground="#DDD" BorderBrush="#333"
                         VirtualizingStackPanel.IsVirtualizing="True"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333"/>

            <!-- 3D viewport. Wrapped in a Viewbox that renders the viewport at 2x internal resolution then
                 scales it down (supersampling) — WPF's Viewport3D under-samples textures at 1:1, which softens
                 them; supersampling restores crispness. Same scheme as the D3 viewer. -->
            <Grid Grid.Column="2" x:Name="ViewportSlot" ClipToBounds="True" SizeChanged="OnViewportSlotSizeChanged">
                <Viewbox Stretch="Fill">
                    <h:HelixViewport3D x:Name="Viewport" Width="900" Height="700"
                                       Background="#1C1E22"
                                       ModelUpDirection="0,0,1"
                                       ShowCoordinateSystem="True"
                                       ShowViewCube="True"
                                       ZoomExtentsWhenLoaded="True">
                        <!-- No DefaultLights: a neutral grey rig is added in RebuildScene so textures
                             read untinted (the warm default rig turns grey metal gold). -->
                        <ModelVisual3D x:Name="ModelHost"/>
                    </h:HelixViewport3D>
                </Viewbox>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#333"/>

            <!-- Geoset visibility panel -->
            <DockPanel Grid.Column="4" Margin="0,0,8,8">
                <TextBlock DockPanel.Dock="Top" Text="Geosets" Foreground="#DDD"
                           FontWeight="Bold" Margin="4,2,4,4"/>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,6">
                    <ComboBox DockPanel.Dock="Right" x:Name="LodCombo" Width="70"
                              SelectionChanged="OnLodChanged" Visibility="Collapsed"
                              ToolTip="Level of detail (LOD 0 = full)"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="All" Width="42" Padding="2" Click="OnShowAllGeosets"/>
                        <Button Content="None" Width="42" Padding="2" Margin="4,0,0,0" Click="OnHideAllGeosets"/>
                        <Button Content="Reset" Width="52" Padding="2" Margin="4,0,0,0" Click="OnResetGeosets"
                                ToolTip="Restore the default set (hides GEOA-invisible geosets)"/>
                    </StackPanel>
                </DockPanel>
                <!-- Animation playback panel -->
                <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                    <TextBlock Text="Animation" Foreground="#DDD" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="AnimCombo" SelectionChanged="OnAnimSelected" IsEnabled="False"
                              ToolTip="The model's sequences"/>
                    <DockPanel Margin="0,6,0,0">
                        <ToggleButton x:Name="PlayButton" Content="▶" Width="34" IsEnabled="False"
                                      Checked="OnPlayToggled" Unchecked="OnPlayToggled" ToolTip="Play / pause"/>
                        <CheckBox x:Name="LoopCheck" Content="Loop" IsChecked="True" Foreground="#CCC"
                                  VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock x:Name="SpeedLabel" DockPanel.Dock="Right" Foreground="#9AA" Text="1.0×"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="3" Value="1"
                            ValueChanged="OnSpeedChanged" ToolTip="Playback speed" Margin="0,4,0,0"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock x:Name="FrameLabel" DockPanel.Dock="Right" Foreground="#9AA" Text=""
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <Slider x:Name="FrameSlider" Minimum="0" Maximum="1"
                                ValueChanged="OnFrameScrubbed" ToolTip="Scrub time"/>
                    </DockPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#14161A" BorderBrush="#333" BorderThickness="1">
                    <ItemsControl x:Name="GeosetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" Margin="6,2"
                                          Foreground="#CCC" ToolTip="{Binding Tip}">
                                    <TextBlock Text="{Binding Label}" Foreground="{Binding LabelBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
